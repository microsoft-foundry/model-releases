# Copy this file to `.env` in THIS folder, fill in the blanks, then run the
# notebooks in this capsule. `.env` is git-ignored — never commit it.
#
# Auth: run `az login` (Entra ID). No API key is needed.

# Foundry project endpoint (project: contoso-travel-releases).
# Format: https://<resource>.services.ai.azure.com/api/projects/contoso-travel-releases
MICROSOFT_FOUNDRY_ENDPOINT=

# Your model-router deployment name (this project uses a 125K TPM deployment).
AZURE_MODEL_ROUTER_DEPLOYMENT=model-router

# The prompt agent from notebook 00 (setup smoke test).
AGENT_NAME=contoso-travel-concierge

# Model deployments, named by the job they do (not the model) so you can swap the
# model behind a name later without editing a notebook. All four are deployed in 00.
AZURE_FRONTIER_DEPLOYMENT=quality-baseline       # frontier + optimizer candidate model
AZURE_BASELINE_CHEAP_DEPLOYMENT=cheap-baseline   # cheap fixed-model reference
AZURE_EVAL_DEPLOYMENT=scoring-judge              # scores answers (optimizer eval_model + rubric judge)

# Agents this capsule creates (idempotent — reused if they already exist).
AZURE_OPTIMIZER_AGENT_NAME=contoso-travel-optimizer          # notebook 01
AZURE_DECOMPOSITION_AGENT_NAME=contoso-travel-decomposition  # notebook 02

# Optimizer artifacts (notebook 01): the uploaded eval dataset and generated rubric.
AZURE_OPTIMIZER_DATASET_NAME=contoso-travel-eval
AZURE_OPTIMIZER_RUBRIC_NAME=contoso-policy-rubric

# Optional — enables a direct portal deep link to the optimizer run (notebook 01, §7).
# The SDK endpoint doesn't carry these, so set them for a clickable Optimize-tab link.
# AZURE_SUBSCRIPTION_ID=
# AZURE_RESOURCE_GROUP=

# Optional — named routers for the mode/subset climb (notebooks 03-04).
# AZURE_MODEL_ROUTER_COST_DEPLOYMENT=model-router-cost
# AZURE_MODEL_ROUTER_QUALITY_DEPLOYMENT=model-router-quality
