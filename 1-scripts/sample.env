# Microsoft Foundry connection
# Populated by setup.ipynb (which runs 1-scripts/setenv.sh), or fill in by hand.
# Reference: https://learn.microsoft.com/en-us/azure/foundry/how-to/create-projects
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_RESOURCE_GROUP=
MICROSOFT_FOUNDRY_PROJECT_NAME=
MICROSOFT_FOUNDRY_ENDPOINT=
MICROSOFT_FOUNDRY_API_KEY=
MICROSOFT_FOUNDRY_REGION=

# Capsule deployment names — uncomment and set for each deployment your capsule needs.
# CHAT_DEPLOYMENT=

# model router capsule (4-models/model-router/)
# Your model-router deployment name; authenticate with `az login` (no API key needed).
# The aug-2026 series adds named variants per routing lever — uncomment as you build them.
AZURE_MODEL_ROUTER_DEPLOYMENT=model-router
AGENT_NAME=contoso-travel-concierge
# AZURE_MODEL_ROUTER_COST_DEPLOYMENT=model-router-cost
# AZURE_MODEL_ROUTER_QUALITY_DEPLOYMENT=model-router-quality

# MAI-Image-2.6 capsules (4-models/mai-image-2.6*/, 5-multi-model/mai-image-family-walkthrough/)
# Default values match the model name; change if your deployment uses a different name.
# Set MAI_IMAGE_ENDPOINT only if the MAI deployments are in a different project from MICROSOFT_FOUNDRY_ENDPOINT.
AZURE_MAI_IMAGE_26_DEPLOYMENT=MAI-Image-2.6
AZURE_MAI_IMAGE_26_FLASH_DEPLOYMENT=MAI-Image-2.6-Flash
MAI_IMAGE_REQUESTS_PER_MINUTE=6
# MAI_IMAGE_ENDPOINT=

# MAI-Transcribe and MAI-Voice capsules (4-models/mai-transcribe-2/, 4-models/mai-voice-2/)
# No deployment needed — the model is named in the request. Set the endpoint
# override only if your Speech resource differs from the Foundry project resource.
# AZURE_SPEECH_ENDPOINT=
# AZURE_SPEECH_API_KEY=

# fal video capsules (4-models/fal-*/)
# Register Fal.EnableDeploy on the subscription and deploy the models first; authenticate with `az login`.
# Default values match the catalog names; change if your deployments use different names.
AZURE_FAL_KLING_V3_PRO_DEPLOYMENT=Fal-Kling-V3-Pro
AZURE_FAL_LTX_25_PRO_DEPLOYMENT=Fal-LTX-2.5-Pro
AZURE_FAL_LTX_25_FAST_DEPLOYMENT=Fal-LTX-2.5-Fast
AZURE_FAL_MINIMAX_H3_MAX_DEPLOYMENT=Fal-MiniMax-H3-Max
AZURE_FAL_MINIMAX_H3_MAX_TURBO_DEPLOYMENT=Fal-MiniMax-H3-Max-Turbo
# replay = show saved clips from each capsule's examples/ (no Azure calls). live = generate new clips.
DEMO_MODE=replay
# Requests per minute per deployment (2 on quota tiers 1–4).
FAL_REQUESTS_PER_MINUTE=2
# true = embed a video player under each clip; false = frame strips only (keeps saved notebooks small).
PLAY_INLINE=true

# ============================================================================
# ARCHIVE — settings for capsules in 0-archive/. Only needed to rerun them.
# ============================================================================

# MAI-Image-2.5 capsules and walkthrough (0-archive/mai-image-2.5*/)
AZURE_MAI_IMAGE_25_DEPLOYMENT=MAI-Image-2.5
AZURE_MAI_IMAGE_25_FLASH_DEPLOYMENT=MAI-Image-2.5-Flash
AZURE_MAI_IMAGE_25_PRO_DEPLOYMENT=MAI-Image-2.5-Pro

# MAI-Transcribe-1.5 capsule (0-archive/mai-transcribe-1.5/)
MAI_TRANSCRIBE_MODEL=mai-transcribe-1.5
