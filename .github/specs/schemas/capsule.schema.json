{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/microsoft-foundry/model-releases/schemas/capsule.schema.json",
  "title": "Capsule",
  "description": "Frontmatter contract for a release capsule README.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "family", "model", "release_date", "capabilities", "model_card"],
  "properties": {
    "kind": { "const": "capsule" },
    "family": {
      "type": "string",
      "description": "Family slug (kebab-case) matching a folder under models/.",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "model": {
      "type": "string",
      "description": "Model slug (kebab-case).",
      "pattern": "^[a-z0-9]+([-.][a-z0-9]+)*$"
    },
    "release_date": {
      "type": "string",
      "format": "date",
      "description": "Public release date (YYYY-MM-DD) — matches the capsule folder name."
    },
    "expires": {
      "type": ["string", "null"],
      "format": "date",
      "description": "Retirement date if known; feeds the Expiring Soon section."
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "chat-completion", "reasoning", "multimodal", "vision",
          "image-generation", "embeddings", "audio-speech",
          "function-calling", "model-router", "fine-tuning", "long-context"
        ]
      }
    },
    "model_card": {
      "type": "string",
      "format": "uri",
      "description": "Official model card URL. Prefer learn.microsoft.com when available."
    },
    "announcement": {
      "type": ["string", "null"],
      "format": "uri",
      "description": "Official release-announcement URL."
    },
    "pricing": {
      "type": ["object", "null"],
      "properties": {
        "url": { "type": ["string", "null"], "format": "uri", "description": "Official pricing page — surfaced in the Recently added table." },
        "input_per_1k": { "type": ["string", "number", "null"] },
        "output_per_1k": { "type": ["string", "number", "null"] },
        "notes": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "dependencies": {
      "type": "array",
      "description": "Capsule-specific Python deps appended to requirements-dev.txt.",
      "items": { "type": "string" }
    },
    "notebooks": {
      "type": "array",
      "description": "Notebooks shipped with this capsule (paths relative to the capsule folder). Each notebook covers 1–3 concepts; split large releases into multiple notebooks rather than growing one.",
      "items": {
        "type": "object",
        "required": ["path", "title", "concepts"],
        "properties": {
          "path": { "type": "string", "description": "Relative path, e.g. notebooks/01-send-a-chat-request.ipynb" },
          "title": { "type": "string" },
          "concepts": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    },
    "domains": {
      "type": "array",
      "description": "Real-world domains the interesting use cases explore.",
      "items": { "type": "string" }
    },
    "references": {
      "type": "array",
      "description": "Author-supplied best-practice references (model card, official docs, sample repos, blog posts) surfaced at the end of the capsule README and in the notebook's final References section.",
      "items": {
        "type": "object",
        "required": ["title", "url"],
        "properties": {
          "title": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "kind": {
            "enum": ["model-card", "docs", "sample", "blog", "paper", "video", "other"]
          },
          "note": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  }
}
